---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
Astro.response.status = 404;
---

<BaseLayout title="Page Not Found">
  <div class="nf-container container">
    <p class="nf-code" aria-hidden="true">404</p>
    <h1>Page not found</h1>
    <p class="nf-desc">The page you're looking for doesn't exist or has moved.</p>
    <div class="nf-actions">
      <a class="btn btn-primary" href={`${base}`}>Back to home</a>
      <a class="btn btn-ghost" href={`${base}browse/`}>Browse questions</a>
    </div>
  </div>
</BaseLayout>

<style>
  .nf-container {
    max-width: 640px;
    text-align: center;
    padding: var(--space-3xl) 0;
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
  }

  .nf-code {
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--accent);
  }

  .nf-desc {
    color: var(--text-secondary);
  }

  .nf-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
