---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { categories } from '../../data/categories.json';
import { questions } from '../../data/questions.json';
import { inlineMarkdown } from '../lib/markdown';

const base = import.meta.env.BASE_URL;
const cats = categories;
const totalQuestions = cats.reduce((sum, c) => sum + c.questionCount, 0);

const today = new Date().toISOString().slice(0, 10);
let hash = 0;
for (let i = 0; i < today.length; i++) {
  hash = ((hash << 5) - hash + today.charCodeAt(i)) | 0;
}
const qotd = questions[Math.abs(hash) % questions.length];
---

<BaseLayout title="DroidPrep" description={`Master Android technical interviews with ${totalQuestions} curated questions across ${cats.length} core topics.`}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-content">
      <div class="hero-badge">
        <span class="badge badge-basic">Free &amp; Open Source</span>
      </div>
      <h1 class="hero-title">
        Master your <span class="highlight">Android</span><br />
        technical interview
      </h1>
      <p class="hero-subtitle">
        {totalQuestions} curated questions across {cats.length} core topics — from Kotlin fundamentals to system design.
        Search, study, and test yourself with multiple choice quizzes.
      </p>
      <div class="hero-actions">
        <a href={`${base}browse`} class="btn btn-primary">Start Browsing</a>
        <a href={`${base}quiz`} class="btn btn-secondary">Take a Quiz</a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-value">{totalQuestions}</span>
          <span class="stat-label">Questions</span>
        </div>
        <div class="stat">
          <span class="stat-value">{cats.length}</span>
          <span class="stat-label">Categories</span>
        </div>
        <div class="stat">
          <span class="stat-value">100%</span>
          <span class="stat-label">Free</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Question of the Day -->
  <section class="qotd-section">
    <div class="container">
      <div class="qotd-card card">
        <div class="qotd-header">
          <span class="qotd-badge">Question of the Day</span>
          <span class="qotd-category">{qotd.categoryLabel}</span>
        </div>
        <h2 class="qotd-question">{qotd.question}</h2>
        <p class="qotd-answer" set:html={inlineMarkdown(qotd.answer)}></p>
        <a href={`${base}browse?category=${qotd.category}`} class="btn btn-secondary">Practice this category</a>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="categories-section">
    <div class="container">
      <h2 class="section-title">Browse by category</h2>
      <p class="section-subtitle">Pick a topic and start studying</p>
      <div class="categories-grid">
        {cats.map(cat => (
          <CategoryCard
            id={cat.id}
            name={cat.name}
            icon={cat.icon}
            description={cat.description}
            color={cat.color}
            questionCount={cat.questionCount}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="features-section">
    <div class="container">
      <h2 class="section-title">Everything you need to prepare</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon gradient-green">&#x1F50E;</div>
          <h3>Full-text search</h3>
          <p>Find exactly what you need across all {totalQuestions} questions with instant client-side search.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon gradient-blue">&#x2705;</div>
          <h3>Multiple choice quizzes</h3>
          <p>Test yourself with quality MCQ options targeting real interview misconceptions.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon gradient-purple">&#x1F4CC;</div>
          <h3>Bookmark questions</h3>
          <p>Save questions for later and filter to your saved list — all stored locally in your browser.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon gradient-orange">&#x1F4DA;</div>
          <h3>Code examples</h3>
          <p>Every answer includes real Kotlin code examples with syntax highlighting.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container cta-content">
      <h2>Ready to ace your interview?</h2>
      <p>Start with a quiz in your weakest category, or browse everything first.</p>
      <div class="cta-actions">
        <a href={`${base}quiz`} class="btn btn-primary">Take a Quiz</a>
        <a href={`${base}browse`} class="btn btn-ghost">Browse Questions</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-3xl) 0;
    text-align: center;
    background:
      radial-gradient(ellipse at top, rgba(61, 220, 132, 0.08), transparent 50%),
      radial-gradient(ellipse at bottom right, rgba(66, 133, 244, 0.05), transparent 50%);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    max-width: 720px;
    margin: 0 auto;
  }

  .hero-badge {
    margin-bottom: var(--space-sm);
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
  }

  .highlight {
    color: var(--accent);
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 560px;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .hero-stats {
    display: flex;
    gap: var(--space-2xl);
    margin-top: var(--space-xl);
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .stat-value {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--text-primary);
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Question of the Day */
  .qotd-section {
    padding-bottom: var(--space-3xl);
  }

  .qotd-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-2xl);
    background:
      linear-gradient(135deg, rgba(61, 220, 132, 0.06), rgba(66, 133, 244, 0.06)),
      var(--bg-card);
    text-align: left;
  }

  .qotd-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .qotd-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25em 0.8em;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    background: rgba(61, 220, 132, 0.12);
    border: 1px solid rgba(61, 220, 132, 0.3);
    border-radius: var(--radius-full);
  }

  .qotd-category {
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .qotd-question {
    font-size: var(--text-2xl);
    line-height: 1.3;
    margin: 0;
  }

  .qotd-answer {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .qotd-card .btn {
    align-self: flex-start;
  }

  /* Categories */
  .categories-section {
    padding: var(--space-3xl) 0;
  }

  .section-title {
    text-align: center;
    font-size: var(--text-3xl);
    margin-bottom: var(--space-sm);
  }

  .section-subtitle {
    text-align: center;
    color: var(--text-muted);
    margin-bottom: var(--space-2xl);
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  /* Features */
  .features-section {
    padding: var(--space-3xl) 0;
    background: var(--bg-card);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .features-section .section-title {
    margin-bottom: var(--space-2xl);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-lg);
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-xl);
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
  }

  .feature-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .feature-card h3 {
    font-size: var(--text-lg);
  }

  .feature-card p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    font-size: 1.4em;
  }

  .gradient-green {
    background: rgba(61, 220, 132, 0.15);
  }

  .gradient-blue {
    background: rgba(66, 133, 244, 0.15);
  }

  .gradient-purple {
    background: rgba(127, 82, 255, 0.15);
  }

  .gradient-orange {
    background: rgba(255, 109, 0, 0.15);
  }

  /* CTA */
  .cta-section {
    padding: var(--space-3xl) 0;
    text-align: center;
  }

  .cta-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-2xl);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    max-width: 720px;
  }

  .cta-content h2 {
    font-size: var(--text-2xl);
  }

  .cta-content p {
    color: var(--text-secondary);
  }

  .cta-actions {
    display: flex;
    gap: var(--space-md);
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions .btn {
      justify-content: center;
      width: 100%;
    }

    .hero-stats {
      gap: var(--space-lg);
    }

    .cta-actions {
      flex-direction: column;
      width: 100%;
    }

    .cta-actions .btn {
      justify-content: center;
    }
  }
</style>
