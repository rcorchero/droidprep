---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuestionCard from '../components/QuestionCard.astro';
import questionsData from '../../data/questions.json';
import categoriesData from '../../data/categories.json';
import difficultyData from '../../data/difficulty.json';

const allQuestions = questionsData.questions;
const categories = categoriesData.categories;
const difficulties = difficultyData.difficulties as Record<string, string>;
const categoryColorMap = Object.fromEntries(categories.map(c => [c.id, c.color]));
---

<BaseLayout title="Browse Questions">
  <div class="browse-header">
    <div class="container">
      <h1>Question Database</h1>
      <p class="subtitle">Browse all {allQuestions.length} questions across {categories.length} categories. Click a question to expand the answer.</p>

      <div class="search-container">
        <div class="search-box">
          <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="text"
            id="search-input"
            placeholder="Search questions, answers, topics..."
            aria-label="Search questions"
          />
        </div>
      </div>

      <div class="filters">
        <div class="filter-group">
          <span class="filter-label">Category:</span>
          <select id="category-filter" aria-label="Filter by category">
            <option value="all">All categories</option>
            {categories.map(cat => (
              <option value={cat.id}>{cat.name}</option>
            ))}
          </select>
        </div>
        <div class="filter-group">
          <span class="filter-label">Difficulty:</span>
          <select id="difficulty-filter" aria-label="Filter by difficulty">
            <option value="all">All levels</option>
            <option value="basic">Basic</option>
            <option value="intermediate">Intermediate</option>
            <option value="senior">Senior</option>
          </select>
        </div>
        <div class="filter-group">
          <button id="saved-filter" class="saved-filter" aria-pressed="false">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>Saved</span>
            <span id="saved-count" class="saved-count" hidden>0</span>
          </button>
        </div>
        <div class="filter-group count-display">
          <span id="count-display">{allQuestions.length} questions</span>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="questions-list" id="questions-list">
      {allQuestions.map(q => (
        <QuestionCard
          id={q.id}
          category={q.category}
          question={q.question}
          answer={q.answer}
          whyItMatters={q.whyItMatters}
          codeExample={q.codeExample}
          furtherReading={q.furtherReading}
          categoryLabel={q.categoryLabel}
          categoryColor={categoryColorMap[q.category] || '#3DDC84'}
          difficulty={difficulties[q.id] || 'unknown'}
        />
      ))}
    </div>
    <div id="no-results" class="no-results" hidden>
      <p id="no-results-msg">No questions match your search. Try different keywords.</p>
    </div>
  </div>
</BaseLayout>

<script>
  import { mountBrowse } from '../lib/browse-app';

  // Bundled module scripts run once. Registering on `astro:page-load` mounts
  // the browse UI on initial load and after every client-side navigation.
  document.addEventListener('astro:page-load', () => {
    mountBrowse();
  });
</script>

<style>
  .browse-header {
    padding: var(--space-2xl) 0 var(--space-xl);
    text-align: center;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
  }

  .browse-header h1 {
    margin-bottom: var(--space-sm);
  }

  .subtitle {
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
  }

  .search-container {
    max-width: 560px;
    margin: 0 auto var(--space-lg);
  }

  .search-box {
    position: relative;
  }

  .search-icon {
    position: absolute;
    left: var(--space-md);
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
  }

  #search-input {
    width: 100%;
    padding: var(--space-md) var(--space-md) var(--space-md) 2.75rem;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    transition: border-color var(--transition-fast);
  }

  #search-input:focus {
    outline: none;
    border-color: var(--accent);
  }

  #search-input::placeholder {
    color: var(--text-muted);
  }

  .filters {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .filter-label {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  select {
    padding: var(--space-sm) var(--space-md);
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  select:focus {
    outline: none;
    border-color: var(--accent);
  }

  .saved-filter {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .saved-filter:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .saved-filter:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .saved-filter.active {
    background: rgba(61, 220, 132, 0.15);
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 600;
  }

  .saved-count {
    background: var(--accent);
    color: var(--android-dark);
    font-size: var(--text-xs);
    font-weight: 700;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .count-display span {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-weight: 500;
  }

  .questions-list {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .no-results {
    text-align: center;
    padding: var(--space-2xl) 0;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .filters {
      flex-direction: column;
      gap: var(--space-md);
      align-items: stretch;
    }

    .filter-group {
      width: 100%;
    }

    .filter-group select {
      flex: 1 1 0%;
      min-width: 0;
      max-width: 360px;
    }

    .saved-filter {
      min-height: 44px;
    }

    .count-display {
      justify-content: center;
    }
  }
</style>
