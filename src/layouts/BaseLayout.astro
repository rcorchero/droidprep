---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Technical interview prep for Android engineers — searchable Q&A database and multiple choice quizzes.' } = Astro.props;

const base = import.meta.env.BASE_URL;
const site = import.meta.env.SITE || '';
const path = Astro.url.pathname;
const canonical = site + base.replace(/\/$/, '') + path.replace(new RegExp('^' + base), '/');
const ogImage = site + base + 'og-image.svg';
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | DroidPrep</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="DroidPrep" />
  <meta property="og:title" content={`${title} | DroidPrep`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={`${title} | DroidPrep`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <script is:inline>
    (function() {
      const mql = window.matchMedia('(prefers-color-scheme: light)');
      function applyTheme(force) {
        const stored = localStorage.getItem('theme');
        const isLight = force != null ? force : (stored ? stored === 'light' : mql.matches);
        document.documentElement.classList.toggle('dark', !isLight);
        document.documentElement.classList.toggle('light', isLight);
      }
      // Expose globally so the toggle can reuse it across view-transition swaps
      window.applyTheme = applyTheme;
      applyTheme();
      // Re-apply after Astro client-side navigation swaps the document
      document.addEventListener('astro:after-swap', function() {
        applyTheme();
      });
      mql.addEventListener('change', function() {
        if (!localStorage.getItem('theme')) applyTheme();
      });
    })();
  </script>
  <ClientRouter />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
