---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { site, base } from '../../site.config.mjs';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Technical interview prep for Android engineers — searchable Q&A database and multiple choice quizzes.' } = Astro.props;

const path = Astro.url.pathname;
const canonical = site + base.replace(/\/$/, '') + path.replace(new RegExp('^' + base), '/');
const ogImage = site + base + 'og-image.png';
// sha256 (base64) of the two inline scripts emitted below, computed from the
// exact bytes that appear in dist HTML. Keep in sync — verify at build.
const themeScriptSha256 = 'bKhCGEOtLBq88qApl09g43qon7/6xe53mmTB17EYXaI=';
const toggleScriptSha256 = '1hf6+dmRilwA8Hqc938o8KVmjonQt2sKgXiyiL8wsWY=';
// Note: `frame-ancestors` is deliberately absent — it is ignored when delivered
// via a <meta> element and only adds a console warning.
const cspContent = `default-src 'self'; script-src 'self' 'sha256-${themeScriptSha256}' 'sha256-${toggleScriptSha256}'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'`;
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#1B1B2F" />
  <title>{title} | DroidPrep</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="DroidPrep" />
  <meta property="og:title" content={`${title} | DroidPrep`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={`${title} | DroidPrep`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={cspContent} />}
  <script is:inline>
    (function () {
      var THEME_KEY = 'theme';
      var mql = window.matchMedia('(prefers-color-scheme: light)');
      function applyTheme(force) {
        var stored = localStorage.getItem(THEME_KEY);
        var isLight = force != null ? force : (stored ? stored === 'light' : mql.matches);
        document.documentElement.classList.toggle('dark', !isLight);
        document.documentElement.classList.toggle('light', isLight);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', isLight ? '#F5F5FA' : '#1B1B2F');
      }
      // Expose globally so the toggle can reuse it across view-transition swaps
      window.applyTheme = applyTheme;
      applyTheme();
      // Bind document-level listeners once: inline scripts re-execute on every
      // view-transition visit, which would otherwise stack duplicate handlers.
      if (!window.__themeGuardBound) {
        window.__themeGuardBound = true;
        // Re-apply after Astro client-side navigation swaps the document
        document.addEventListener('astro:after-swap', function () {
          applyTheme();
        });
        mql.addEventListener('change', function () {
          if (!localStorage.getItem(THEME_KEY)) applyTheme();
        });
      }
    })();
  </script>
  <ClientRouter />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
