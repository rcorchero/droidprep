---
import { Code } from 'astro:components';
import { inlineMarkdown } from '../lib/markdown';

interface Props {
  id: string;
  category: string;
  question: string;
  answer: string;
  whyItMatters?: string;
  codeExample?: string;
  furtherReading?: { text: string; url: string }[];
  categoryLabel: string;
  categoryColor: string;
  difficulty?: string;
}

const {
  id,
  category,
  question,
  answer,
  whyItMatters = '',
  codeExample = '',
  furtherReading = [],
  categoryLabel,
  categoryColor,
  difficulty = 'unknown',
} = Astro.props;

const searchText = `${question} ${answer} ${categoryLabel} ${whyItMatters}`.toLowerCase();
const qHTML = inlineMarkdown(question);
const ansLines = answer.split('\n');
const answerParts = ansLines.map(line => {
  const trimmed = line.trim();
  // Detect markdown bullet lines (`- item`) and separate the marker
  // so the styling can be applied in the template.
  if (trimmed.startsWith('- ')) {
    return { text: inlineMarkdown(trimmed.replace(/^- /, '')), isBullet: true };
  }
  return { text: inlineMarkdown(line), isBullet: false };
});
const whyHTML = inlineMarkdown(whyItMatters);
---

<article
  class="question-card card"
  data-question-id={id}
  data-search-text={searchText}
  data-difficulty={difficulty}
  data-category={category}
>
  <div class="question-header">
    <button class="question-toggle" aria-expanded="false">
      <span class="question-category" style={`--cat-color: ${categoryColor}`}>{categoryLabel}</span>
      <h2 class="question-text" set:html={qHTML}></h2>
      {difficulty !== 'unknown' && (
        <span class:list={['badge', `badge-${difficulty}`]}>
          <span class="badge-dot" aria-hidden="true"></span>
          <span class="badge-text">{difficulty}</span>
        </span>
      )}
      <span class="toggle-state" aria-hidden="true">Show answer</span>
    </button>
    <div class="header-actions">
      <span class="bookmark-btn" data-bookmark={id} role="button" tabindex="0" aria-label="Save question" aria-pressed="false" title="Save this question">
        <svg class="bookmark-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </svg>
        <span class="bookmark-label">Save</span>
      </span>
      <button class="chevron" aria-label="Toggle answer" aria-expanded="false">&#x25BC;</button>
    </div>
  </div>

  <div class="question-answer" hidden>
    <div class="answer-section">
      <h4 class="answer-label">Answer</h4>
      <div class="answer-body">
        {answerParts.map(({ text, isBullet }) => (
          isBullet ? (
            <p class="answer-bullet" set:html={text}></p>
          ) : (
            <p set:html={text}></p>
          )
        ))}
      </div>
    </div>

    {whyItMatters && (
      <div class="why-section">
        <h4 class="why-label">Why it matters</h4>
        <p set:html={whyHTML}></p>
      </div>
    )}

    {codeExample && (
      <div class="code-section">
        <div class="code-header">
          <h4 class="code-label">Kotlin</h4>
          <button class="copy-btn" data-copy aria-label="Copy code">Copy</button>
        </div>
        <Code code={codeExample} lang="kotlin" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} wrap={true} />
      </div>
    )}

    {furtherReading.length > 0 && (
      <div class="reading-section">
        <h4 class="reading-label">Further reading</h4>
        <ul class="reading-links">
          {furtherReading.map(link => (
            <li>
              <a href={link.url} target="_blank" rel="noopener noreferrer">{link.text}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</article>

<style>
  .question-card {
    padding: 0;
    overflow: hidden;
    margin-bottom: var(--space-md);
    content-visibility: auto;
    contain-intrinsic-size: auto 96px;
  }

  .question-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg);
  }

  .question-toggle {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-md);
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-family: var(--font-sans);
  }

  .question-category {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--cat-color);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  html.dark .question-category {
    color: color-mix(in srgb, var(--cat-color) 85%, #FFFFFF);
  }

  html.light .question-category {
    color: color-mix(in srgb, var(--cat-color) 55%, var(--android-dark));
  }

  .question-text {
    flex: 1;
    min-width: 0;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.4;
  }

  .toggle-state {
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    white-space: nowrap;
    padding: 0.15em 0.5em;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
    margin-left: auto;
  }

  .bookmark-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: var(--space-xs);
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-family: var(--font-sans);
    transition: color var(--transition-fast);
  }

  .bookmark-btn:hover,
  .bookmark-btn:focus-visible,
  .bookmark-btn.bookmarked {
    color: var(--warning);
  }

  .bookmark-btn:focus-visible {
    outline: 2px solid var(--warning);
    outline-offset: 2px;
  }

  .bookmark-btn.bookmarked .bookmark-icon {
    fill: var(--warning);
    stroke: var(--warning);
  }

  .chevron {
    color: var(--text-muted);
    font-size: var(--text-sm);
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: none;
    cursor: pointer;
    padding: 0;
    font-family: var(--font-sans);
    transition: transform var(--transition-base), color var(--transition-fast),
      border-color var(--transition-fast), background var(--transition-fast);
  }

  .chevron:hover {
    color: var(--text-primary);
    border-color: var(--text-muted);
  }

  .chevron:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .chevron.open {
    transform: rotate(180deg);
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-dim);
  }

  @media (max-width: 768px) {
    .question-header {
      align-items: flex-start;
      gap: var(--space-sm);
      padding: var(--space-md);
    }

    .question-toggle {
      flex-wrap: wrap;
      column-gap: var(--space-sm);
      row-gap: var(--space-xs);
    }

    .question-category {
      flex-basis: 100%;
    }

    .question-toggle .badge {
      flex-shrink: 0;
    }

    .toggle-state {
      display: none;
    }

    .bookmark-label {
      display: none;
    }

    .bookmark-btn {
      padding: var(--space-sm);
    }

    .chevron {
      width: 40px;
      height: 40px;
      font-size: var(--text-base);
    }
  }

  .question-answer {
    padding: 0 var(--space-lg) var(--space-lg);
    border-top: 1px solid var(--border);
    padding-top: var(--space-lg);
    animation: fadeIn var(--transition-base);
  }

  .answer-section,
  .why-section,
  .code-section,
  .reading-section {
    margin-bottom: var(--space-lg);
  }

  .answer-label,
  .why-label,
  .code-label,
  .reading-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .why-label {
    color: var(--info);
  }

  .code-label {
    color: var(--accent);
  }

  .reading-label {
    color: var(--kotlin-purple);
  }

  .answer-body p {
    margin-bottom: var(--space-sm);
  }

  .answer-bullet {
    padding-left: var(--space-md);
    position: relative;
  }

  .answer-bullet::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  :global(.inline-code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.35em;
    color: var(--compose-blue);
  }

  :global(.question-text strong) {
    color: var(--text-primary);
  }

  :global(.answer-body strong) {
    color: var(--accent);
    font-weight: 600;
  }

  .code-section {
    margin-top: var(--space-md);
  }

  .code-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-xs);
  }

  .copy-btn {
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-xs);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .copy-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .reading-links {
    list-style: none;
  }

  .reading-links li {
    margin-bottom: var(--space-xs);
  }

  .reading-links a {
    font-size: var(--text-sm);
    word-break: break-all;
  }
</style>
