<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-text">
      Built for Android engineers, by Android engineers.
    </p>
    <p class="footer-text footer-muted">
      Open source &middot; <a class="footer-link" href="https://github.com/rcorchero/droidprep" target="_blank" rel="noopener">GitHub</a> &middot; Contribute
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-3xl);
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .footer-muted {
    color: var(--text-muted);
  }

  .footer-link {
    display: inline-block;
    padding: 0.25em 0.7em;
    margin: 0 0.2em;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    background: var(--accent-dim);
    color: var(--accent);
    text-decoration: none;
    outline: none;
  }
</style>
